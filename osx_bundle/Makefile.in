SHELL:=/bin/bash

TOP:=$(CURDIR)
PREFIX?=$(TOP)/_bundle
GTK_PREFIX?=@GTK_PREFIX@
GPS_VERSION?=@GPS_VERSION@
PYTHON?=python3

APP:=GNAT Studio.app
DMG:=GNAT-Studio-$(GPS_VERSION)-macos27-arm64.dmg

contents=$(PREFIX)/$(APP)/Contents
root=$(contents)/MacOS
bin=$(root)/bin
etc=$(root)/etc
lib=$(root)/lib
share=$(root)/share
frameworks=$(contents)/Frameworks
resources=$(contents)/Resources

auto-install-dirs: force
	mkdir -p "$(contents)" "$(root)" "$(bin)" "$(lib)" "$(etc)" "$(frameworks)"

.PHONY: all app dmg clean force auto-install-dirs

all: dmg

app: $(PREFIX)/$(APP)

dmg: $(PREFIX)/$(DMG)

clean:
	rm -rf "$(PREFIX)/$(APP)" "$(PREFIX)/$(DMG)" "$(PREFIX)/_dmgroot"

$(PREFIX)/$(APP): force
	rm -rf "$(PREFIX)/$(APP)"
	mkdir -p "$(resources)" "$(root)" "$(bin)" "$(lib)" "$(etc)" "$(frameworks)"
	cp -R "$(TOP)/Resources/." "$(resources)/"
	$(PYTHON) -c 'from pathlib import Path; p=Path("$(contents)/Info.plist"); p.write_text(Path("$(TOP)/srcs/Info.plist").read_text().replace("@GPS_VERSION@", "$(GPS_VERSION)"))'
	install -m 755 "$(TOP)/srcs/gps_bundle_main" "$(root)/gps"

	# Install GNAT Studio itself.
	$(MAKE) -C "$(TOP)/.." install-strip prefix="$(root)" PYTHON="$(PYTHON)"
	find "$(contents)" -name .svn -type d -prune -exec rm -rf {} +

	# GTK runtime data.
	if [[ -d "$(GTK_PREFIX)/lib/girepository-1.0" ]]; then cp -R "$(GTK_PREFIX)/lib/girepository-1.0" "$(lib)/"; fi
	if [[ -d "$(GTK_PREFIX)/lib/gio" ]]; then cp -R "$(GTK_PREFIX)/lib/gio" "$(lib)/"; fi
	if [[ -d "$(GTK_PREFIX)/lib/gdk-pixbuf-2.0" ]]; then cp -R "$(GTK_PREFIX)/lib/gdk-pixbuf-2.0" "$(lib)/"; fi
	if [[ -d "$(GTK_PREFIX)/lib/gtk-3.0" ]]; then cp -R "$(GTK_PREFIX)/lib/gtk-3.0" "$(lib)/"; fi
	mkdir -p "$(lib)/gdk-pixbuf-2.0/2.10.0/loaders"
	if [[ -d "$(GTK_PREFIX)/lib/gdk-pixbuf-2.0/2.10.0/loaders" ]]; then cp -R "$(GTK_PREFIX)/lib/gdk-pixbuf-2.0/2.10.0/loaders/." "$(lib)/gdk-pixbuf-2.0/2.10.0/loaders/"; fi
	if [[ -x "$(GTK_PREFIX)/bin/gdk-pixbuf-query-loaders" ]]; then install -m 755 "$(GTK_PREFIX)/bin/gdk-pixbuf-query-loaders" "$(bin)/"; fi
	if [[ -f "$(GTK_PREFIX)/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache" ]]; then rm -f "$(lib)/gdk-pixbuf-2.0"/*/loaders.cache; fi
	mkdir -p "$(etc)/gtk-3.0"
	cp "$(TOP)/srcs/settings.ini" "$(etc)/gtk-3.0/"
	if [[ -d "$(GTK_PREFIX)/etc/pango" ]]; then cp -R "$(GTK_PREFIX)/etc/pango" "$(etc)/"; fi

	# GTK utilities and Python extensions are repaired after installation by
	# dylibbundler. Keep the runtime in the same lib/ tree as the executable.
	$(PYTHON) "$(TOP)/scripts/bundle_python.py" "$(root)/lib" "$(PYTHON)"

	# GTK data used at runtime.
	mkdir -p "$(share)/themes" "$(share)/locale" "$(share)/icons" "$(share)/glib-2.0"
	if [[ -d "$(GTK_PREFIX)/share/themes" ]]; then cp -R "$(GTK_PREFIX)/share/themes/." "$(share)/themes/"; fi
	if [[ -d "$(GTK_PREFIX)/share/locale" ]]; then cp -R "$(GTK_PREFIX)/share/locale/." "$(share)/locale/"; fi
	if [[ -d "$(GTK_PREFIX)/share/icons" ]]; then cp -R "$(GTK_PREFIX)/share/icons/." "$(share)/icons/"; fi
	if [[ -d "$(GTK_PREFIX)/share/glib-2.0/schemas" ]]; then cp -R "$(GTK_PREFIX)/share/glib-2.0/schemas" "$(share)/glib-2.0/"; fi

	# Pull all external Mach-O dependencies into Contents/Frameworks and rewrite
	# their load commands to use a bundle-relative install name.
	bash "$(TOP)/scripts/bundle_dylibs.sh" \
		"$(root)" \
		"$(frameworks)"

	# Strip linker/build-system leftovers which are never needed at runtime.
	find "$(contents)" -type f \( -name '*.la' -o -name '*.pyc' \) -delete
	find "$(contents)" -type d -name '__pycache__' -prune -exec rm -rf {} +

	# Ad-hoc signing makes the unsigned local build loadable on a normal macOS
	# installation. Replace with Developer ID signing in a release workflow.
	/usr/bin/codesign --force --deep --sign - "$(PREFIX)/$(APP)"

$(PREFIX)/$(DMG): $(PREFIX)/$(APP)
	rm -rf "$(PREFIX)/_dmgroot"
	mkdir -p "$(PREFIX)/_dmgroot"
	cp -R "$(PREFIX)/$(APP)" "$(PREFIX)/_dmgroot/"
	hdiutil create \
		-volname "GNAT Studio" \
		-srcfolder "$(PREFIX)/_dmgroot" \
		-ov \
		-format UDBZ \
		"$(PREFIX)/$(DMG)"
	rm -rf "$(PREFIX)/_dmgroot"
