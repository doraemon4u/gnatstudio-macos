#!/bin/bash
set -e

# Resolve Contents/MacOS even when launched through a symlink.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
bundle_mac="$script_dir"
bundle="$(cd -- "$bundle_mac/.." && pwd -P)"

unset GPS_PYTHONHOME
export LC_ALL="C"

# Keep the application self-contained for GTK/Python runtime libraries.
export PATH="$bundle_mac/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export DYLD_LIBRARY_PATH="$bundle_mac/lib:$bundle/Frameworks:${DYLD_LIBRARY_PATH:-}"

# GNAT Studio's Python bridge can use this bundled Python home. The directory
# contains a lib/pythonX.Y symlink to the runtime copied into Contents/MacOS/lib.
export GNATSTUDIO_PYTHONHOME="${GNATSTUDIO_PYTHONHOME:-$bundle_mac/share/gnatstudio/python}"

# Search for GNAT Studio's preference folder.
PREFS="$HOME/Library/Application Support/AdaCore/GPS"
mkdir -p "$PREFS"

# The bundle can be read-only, so keep the generated loader cache outside it.
pixbuf_base="$bundle_mac/lib/gdk-pixbuf-2.0/2.10.0"
GDK_PIXBUF_MODULE_FILE="$PREFS/pixbuf_loaders.cache"
GDK_PIXBUF_MODULEDIR="$pixbuf_base/loaders"
export GDK_PIXBUF_MODULE_FILE GDK_PIXBUF_MODULEDIR

if [[ -x "$bundle_mac/bin/gdk-pixbuf-query-loaders" ]]; then
    "$bundle_mac/bin/gdk-pixbuf-query-loaders" > "$GDK_PIXBUF_MODULE_FILE"
fi

# Preserve the current directory wrapper convention used by GNAT Studio.
argv=()
for arg in "$@"; do
    case "$arg" in
        -pwd*) cd "${arg#-pwd}" ;;
        *) argv+=("$arg") ;;
    esac
done

exec "$bundle_mac/bin/gnatstudio_exe" "${argv[@]}"
